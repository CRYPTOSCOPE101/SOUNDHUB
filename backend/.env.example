# SoundHub Backend — Environment Variables

# Database (SQLite for dev, PostgreSQL for prod)
SOUNDHUB_DATABASE_URL=sqlite:///data/soundhub.db

# Security
SOUNDHUB_SECRET_KEY=change-me-in-production

# Frontend URL (for links in emails)
SOUNDHUB_FRONTEND_URL=http://localhost:5173

# Upload limit (2 GiB default)
SOUNDHUB_MAX_UPLOAD_SIZE=2147483648

# Stripe (optional — leave empty for manual invoicing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# USDC on Base (optional)
SOUNDHUB_BASE_RPC_URL=
SOUNDHUB_USDC_FALLBACK_PAYEE=

# SMTP (optional — leave empty for log-only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SoundHub <no-reply@soundhub.local>"
