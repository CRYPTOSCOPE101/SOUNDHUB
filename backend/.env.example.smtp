# SoundHub Email Configuration (SMTP — Resend)
#
# Steps (full runbook: docs/email-setup.md):
#   1. buy `soundhub.io` at DreamHost (registrar)
#   2. mailbox soundhub@soundhub.io — Zoho Mail Free (MX/SPF/DKIM у DreamHost)
#   3. resend.com → Domains → add `soundhub.io` → add the DNS records Resend
#      shows (SPF + DKIM) → wait for Verified
#   4. put these into your environment (Render dashboard / `fly secrets set`
#      / local shell) — the backend reads them from os.environ, no .env file
#
# Resend SMTP relay (port 465 = implicit TLS, the backend handles it)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_<your-api-key>
SMTP_FROM=SoundHub <soundhub@soundhub.io>

# Until `soundhub.io` is verified in Resend, sending is limited to your own
# address via the test domain — for a dev smoke override SMTP_FROM to:
#   SMTP_FROM=SoundHub <onboarding@resend.dev>
# (Resend then only allows sending to the account owner's own address.)

# Optional: Resend API key — only needed if we switch to the API path later
# (the reminders module sends via SMTP today).
# RESEND_API_KEY=re_<your-api-key>

# Frontend URL for email links
SOUNDHUB_FRONTEND_URL=https://soundhub-app.vercel.app

# Smoke test once configured (from backend/):
#   SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_USER=resend \
#   SMTP_PASSWORD=re_... SMTP_FROM='SoundHub <soundhub@soundhub.io>' \
#   .venv/bin/python -m scripts.test_smtp you@example.com
