# Private key of the account that deploys SoundHub contracts (Base mainnet / Base Sepolia).
# For testnet deployment any throwaway key works. NEVER commit the real .env file.
DEPLOYER_PRIVATE_KEY=

# Optional RPC overrides
BASE_RPC=https://mainnet.base.org
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Optional Basescan API key for contract verification
BASESCAN_API_KEY=
